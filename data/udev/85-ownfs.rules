# ownfs: have udisks2 mount removable Linux filesystems through ownfs, so the
# desktop user owns everything on the drive, as with FAT, exFAT and NTFS.
#
# udisks2 takes a device's filesystem type from ID_FS_TYPE and its mount
# options from UDISKS_MOUNT_OPTIONS_<TYPE>_* properties, so this rule
# reports removable ext2/3/4, XFS, btrfs and f2fs devices as type "ownfs"
# and keeps the real type in OWNFS_LOWER_TYPE, which ownfs gets as lower=.
# (udisks2 2.10's per-driver options can't be used: they need property names
# with ':', which systemd 259 and later reject.)
#
# The module is loaded first, and only if that works is the device claimed;
# otherwise it keeps its real type and udisks2 mounts it natively.
#
# To opt a device out, set ENV{OWNFS_IGNORE}="1" in an earlier rule.

ACTION=="remove", GOTO="ownfs_end"
SUBSYSTEM!="block", GOTO="ownfs_end"
ENV{ID_FS_USAGE}!="filesystem", GOTO="ownfs_end"
ENV{OWNFS_IGNORE}=="1", GOTO="ownfs_end"
ENV{ID_FS_TYPE}!="ext2|ext3|ext4|xfs|btrfs|f2fs", GOTO="ownfs_end"

# Removable media only: USB, SD/MMC, FireWire, or a removable-flagged disk.
# Internal disks keep normal POSIX ownership.
ENV{ID_BUS}=="usb", GOTO="ownfs_removable"
ENV{ID_BUS}=="ieee1394", GOTO="ownfs_removable"
ENV{ID_DRIVE_FLASH_SD}=="1", GOTO="ownfs_removable"
ENV{ID_DRIVE_MEDIA_FLASH_SD}=="1", GOTO="ownfs_removable"
KERNEL=="mmcblk*", GOTO="ownfs_removable"
ATTRS{removable}=="1", GOTO="ownfs_removable"
GOTO="ownfs_end"

LABEL="ownfs_removable"
PROGRAM!="/sbin/modprobe -q ownfs", GOTO="ownfs_end"
ENV{OWNFS_LOWER_TYPE}="$env{ID_FS_TYPE}"
ENV{ID_FS_TYPE}="ownfs"
ENV{UDISKS_MOUNT_OPTIONS_OWNFS_DEFAULTS}="uid=$$UID,gid=$$GID,lower=$env{OWNFS_LOWER_TYPE}"
ENV{UDISKS_MOUNT_OPTIONS_OWNFS_ALLOW}="uid=$$UID,gid=$$GID,lower=$env{OWNFS_LOWER_TYPE}"
# udisks2 mounts ext2/3/4 with errors=remount-ro; ownfs passes it through.
ENV{OWNFS_LOWER_TYPE}=="ext2|ext3|ext4", ENV{UDISKS_MOUNT_OPTIONS_OWNFS_DEFAULTS}="$env{UDISKS_MOUNT_OPTIONS_OWNFS_DEFAULTS},errors=remount-ro", ENV{UDISKS_MOUNT_OPTIONS_OWNFS_ALLOW}="$env{UDISKS_MOUNT_OPTIONS_OWNFS_ALLOW},errors=remount-ro"

LABEL="ownfs_end"
